---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/utils';
import compData from '../../data/competitions.json';
import ranking from '../../data/ranking.json';

const posts = await getCollection('news');
const today = new Date().toISOString().slice(0, 10);

function newsCount(comp) {
  return posts.filter((p) => {
    if (p.data.competitions.includes(comp.id)) return true;
    const text = `${p.data.title} ${p.data.excerpt}`.toLowerCase();
    if (comp.newsKeywords.some((k) => text.includes(k.toLowerCase()))) return true;
    return p.data.players.some((name) => comp.squad.includes(name));
  }).length;
}

function nextUp(comp) {
  return [
    ...comp.matches.map((m) => ({ date: m.date, text: `${m.home} – ${m.away}` })),
    ...comp.events.map((e) => ({ date: e.date, text: e.label })),
  ]
    .filter((i) => i.date >= today)
    .sort((a, b) => a.date.localeCompare(b.date))[0];
}

function lastResult(comp) {
  return [...comp.matches].filter((m) => m.result).sort((a, b) => b.date.localeCompare(a.date))[0];
}

const PHASES = [
  { id: 'in-corso', label: 'In corso', icon: '🟢' },
  { id: 'futura', label: 'In arrivo', icon: '📅' },
  { id: 'conclusa', label: 'Concluse (ultimi 2 anni)', icon: '🏁' },
];
---

<Base
  title="Nazionali giovanili — Italian Next Gen"
  description="Tutte le competizioni delle nazionali italiane, dalla A all'Under 15: in corso, in arrivo e concluse, con albo d'oro, risultati e news."
  lang="it"
  altPath="/en/national-teams/"
>
  <div class="hero">
    <div class="kicker">Il percorso azzurro · U15 → 2030</div>
    <h1>Le <span class="gold">Nazionali</span>, una per una</h1>
    <p>
      Scegli la nazionale che vuoi approfondire: per ognuna trovi tutte le competizioni —
      in corso, in arrivo e appena concluse — comprese quelle minori che nessuno racconta.
      Albo d'oro, risultati dell'Italia e tutte le news, in un posto solo.
    </p>
    <div class="wc-countdown" data-target="2030-06-08T18:00:00Z">
      <div class="wc-label">− Mondiale 2030 (8 giugno, Spagna·Portogallo·Marocco)</div>
      <div class="wc-digits">
        <span><b class="d-days">—</b><i>giorni</i></span>
        <span><b class="d-hours">—</b><i>ore</i></span>
        <span><b class="d-mins">—</b><i>min</i></span>
        <span><b class="d-secs">—</b><i>sec</i></span>
      </div>
    </div>
  </div>

  <a class="fifa-rank" href={ranking.sourceUrl} target="_blank" rel="noopener">
    <div class="fr-badge">
      <div class="fr-label">Ranking FIFA 🇮🇹</div>
      <div class="fr-pos"><span class="fr-hash">#</span>{ranking.italy.rank}</div>
      <div class="fr-pts">{ranking.italy.points.toLocaleString('it-IT')} punti</div>
      <div class={`fr-trend ${ranking.italy.trend < 0 ? 'down' : ranking.italy.trend > 0 ? 'up' : ''}`}>
        {ranking.italy.trend < 0 ? `▼ ${Math.abs(ranking.italy.trend)}` : ranking.italy.trend > 0 ? `▲ ${ranking.italy.trend}` : '='}
      </div>
    </div>
    <div class="fr-body">
      <p class="fr-note">{ranking.italy.note}</p>
      <div class="fr-table">
        <div class="fr-row fr-top"><span>{ranking.top[0].rank}. {ranking.top[0].team}</span><b>{ranking.top[0].points.toLocaleString('it-IT')}</b></div>
        <div class="fr-row fr-top"><span>{ranking.top[1].rank}. {ranking.top[1].team}</span><b>{ranking.top[1].points.toLocaleString('it-IT')}</b></div>
        <div class="fr-gap">···</div>
        {ranking.around.map((r) => (
          <div class={`fr-row ${r.italy ? 'fr-italy' : ''}`}><span>{r.rank}. {r.team}</span><b>{r.points.toLocaleString('it-IT')}</b></div>
        ))}
      </div>
      <div class="fr-src">Aggiornato: {ranking.updatedLabel} · {ranking.source} →</div>
    </div>
  </a>

  <div class="team-tabs" id="team-tabs">
    {compData.teams.map((t, i) => (
      <button class={`team-tab ${i === 0 ? 'active' : ''}`} data-team={t.id}>{t.label}</button>
    ))}
  </div>

  {compData.teams.map((t, i) => {
    const comps = compData.competitions.filter((c) => c.teamId === t.id);
    return (
      <section class="team-section" data-team={t.id} style={i === 0 ? '' : 'display:none'}>
        {PHASES.map((phase) => {
          const group = comps.filter((c) => c.phase === phase.id);
          if (!group.length) return null;
          return (
            <>
              <div class="section-title">{phase.icon} {phase.label}</div>
              <div class="grid">
                {group.map((c) => {
                  const next = nextUp(c);
                  const last = lastResult(c);
                  const n = newsCount(c);
                  return (
                    <a class="card comp-card" href={`/nazionali/${c.id}/`}>
                      <div class="comp-top">
                        <span class="comp-team">{c.team}</span>
                        <span class="comp-period">{c.period}</span>
                      </div>
                      <h3>{c.name}</h3>
                      <p class="excerpt">{c.italy}</p>
                      {last && (
                        <div class="comp-line"><span class="k">Ultimo risultato</span>{last.home} <b class="gold-txt">{last.result}</b> {last.away}</div>
                      )}
                      {next && (
                        <div class="comp-line"><span class="k">Prossimo evento</span>{formatDate(new Date(next.date), 'it')} · {next.text}</div>
                      )}
                      <div class="comp-line"><span class="k">News collegate</span>{n} {n === 1 ? 'articolo' : 'articoli'}</div>
                      <span class="more">Albo d'oro, calendario e news →</span>
                    </a>
                  );
                })}
              </div>
            </>
          );
        })}
      </section>
    );
  })}

  <script is:inline>
    (function () {
      const tabs = document.querySelectorAll('.team-tab');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((x) => x.classList.toggle('active', x === tab));
          document.querySelectorAll('.team-section').forEach((s) => {
            s.style.display = s.dataset.team === tab.dataset.team ? '' : 'none';
          });
        });
      });
    })();
  </script>

  <style>
    /* ── pannello Ranking FIFA ─────────────── */
    .fifa-rank {
      display: flex; gap: 1.3rem; align-items: stretch; text-decoration: none;
      background: linear-gradient(135deg, rgba(23,58,102,.75), rgba(14,46,82,.55));
      border: 1px solid var(--border-gold); border-radius: 16px;
      padding: 1.1rem 1.3rem; margin: 1.6rem 0 1.9rem;
      box-shadow: 0 10px 30px rgba(0,0,0,.25); transition: border-color .15s ease, transform .15s ease;
    }
    .fifa-rank:hover { border-color: var(--gold); transform: translateY(-2px); }
    .fr-badge {
      flex: 0 0 auto; text-align: center; padding-right: 1.3rem;
      border-right: 1px solid var(--border); display: flex; flex-direction: column; justify-content: center; gap: .1rem;
    }
    .fr-label { font-family: var(--font-display); font-size: .64rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
    .fr-pos { font-family: var(--font-display); font-weight: 800; font-size: 3.1rem; line-height: 1; color: var(--gold); }
    .fr-hash { font-size: 1.5rem; vertical-align: super; opacity: .7; }
    .fr-pts { font-size: .74rem; color: #cfe2f4; margin-top: .15rem; }
    .fr-trend { font-family: var(--font-display); font-size: .82rem; font-weight: 700; margin-top: .3rem; color: var(--muted); }
    .fr-trend.down { color: #ff6b6b; }
    .fr-trend.up { color: #4ade80; }
    .fr-body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: .5rem; min-width: 0; }
    .fr-note { font-size: .86rem; color: #cfe2f4; margin: 0; }
    .fr-table { display: flex; flex-direction: column; gap: .12rem; }
    .fr-row { display: flex; justify-content: space-between; gap: 1rem; font-size: .8rem; color: var(--muted); padding: .12rem 0; }
    .fr-row b { color: #cfe2f4; font-family: var(--font-display); font-weight: 600; }
    .fr-row.fr-top span { color: #cfe2f4; }
    .fr-row.fr-italy { color: var(--gold); font-weight: 700; border-top: 1px dashed var(--border-gold); border-bottom: 1px dashed var(--border-gold); padding: .28rem 0; }
    .fr-row.fr-italy b { color: var(--gold); }
    .fr-gap { color: var(--muted); font-size: .7rem; letter-spacing: .3em; text-align: center; opacity: .6; }
    .fr-src { font-family: var(--font-display); font-size: .66rem; letter-spacing: .06em; color: var(--gold); margin-top: .2rem; }
    @media (max-width: 620px) {
      .fifa-rank { flex-direction: column; gap: .9rem; }
      .fr-badge { border-right: none; border-bottom: 1px solid var(--border); padding-right: 0; padding-bottom: .8rem; flex-direction: row; justify-content: center; align-items: baseline; gap: .6rem; }
      .fr-pos { font-size: 2.4rem; }
    }

    .team-tabs { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: .6rem; }
    .team-tab {
      font-family: var(--font-display); font-size: .82rem; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: var(--muted); background: var(--panel);
      border: 1px solid var(--border); border-radius: 99px; padding: .55rem 1.2rem; cursor: pointer;
      transition: all .15s ease;
    }
    .team-tab:hover { color: var(--ink); border-color: var(--border-gold); }
    .team-tab.active {
      color: var(--bg); background: var(--gold); border-color: var(--gold);
      box-shadow: 0 0 18px rgba(240,201,74,.35);
    }
    .comp-card { text-decoration: none; }
    .comp-top { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
    .comp-team {
      font-family: var(--font-display); font-size: .66rem; font-weight: 700;
      letter-spacing: .18em; text-transform: uppercase; color: var(--bg);
      background: var(--gold); border-radius: 3px; padding: .22rem .55rem;
    }
    .comp-period { font-family: var(--font-display); font-size: .68rem; color: var(--muted); letter-spacing: .05em; }
    .comp-line { font-size: .82rem; color: #cfe2f4; display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
    .comp-line .k {
      font-family: var(--font-display); font-size: .6rem; letter-spacing: .14em;
      text-transform: uppercase; color: var(--muted); min-width: 8.2rem;
    }
    .gold-txt { color: var(--gold); font-family: var(--font-display); }
    .more { font-family: var(--font-display); font-size: .74rem; letter-spacing: .06em; color: var(--gold); margin-top: .3rem; }
  </style>
</Base>
