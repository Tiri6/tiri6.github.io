---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { CATEGORY_LABELS, formatDate, splitBody, renderParagraphs } from '../../lib/utils';
import compData from '../../../data/competitions.json';

const compShort = Object.fromEntries(compData.competitions.map((c) => [c.id, c.short]));

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const body = splitBody(post.body ?? '');
const cat = CATEGORY_LABELS[post.data.category];

// Immagine social per le anteprime (og:image), se generata
import fs from 'node:fs';
const ogImage = fs.existsSync(`public/social/${post.id}.jpg`)
  ? `https://italiannextgen.it/social/${post.id}.jpg`
  : undefined;
---

<Base
  title={`${post.data.title} — Italian Next Gen`}
  description={post.data.excerpt}
  lang="it"
  altPath={`/en/news/${post.id}/`}
  ogImage={ogImage}
>
  <article class="article">
    <div class="article-cover">
      <Cover
        seed={post.id}
        players={post.data.players}
        category={post.data.category}
        image={post.data.image}
        alt={post.data.title}
      />
    </div>
    <div>
      <span class="badge" style={`background:${cat.color}`}>{cat.it}</span>
      <span class="meta" style="margin-left:.6rem">{formatDate(post.data.date, 'it')}</span>
    </div>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.excerpt}</p>
    <div class="body" set:html={post.data.html ? body.it : renderParagraphs(body.it)} />
    {post.data.players.length > 0 && (
      <div class="meta" style="margin-top:1.4rem">⚽ {post.data.players.join(' · ')}</div>
    )}
    {post.data.competitions.length > 0 && (
      <div style="margin-top:.7rem">
        {post.data.competitions.map((id) => compShort[id] && <a class="comp-tag" href={`/nazionali/${id}/`}>{compShort[id]}</a>)}
      </div>
    )}
    {post.data.sourceUrl && (
      <p class="source meta">
        Fonte: <a href={post.data.sourceUrl} target="_blank" rel="noopener">{post.data.source ?? post.data.sourceUrl}</a>
      </p>
    )}

    <div class="share-bar" data-title={post.data.title} data-image={ogImage ?? ''}>
      <a class="share-btn wa" data-wa href="#" target="_blank" rel="noopener">🟢 WhatsApp</a>
      <button class="share-btn ig" data-ig>📸 Instagram</button>
      <button class="share-btn" data-share>📤 Condividi</button>
      <button class="share-btn" data-copy>🔗 Copia link</button>
    </div>
    <script is:inline>
      (function () {
        var bar = document.querySelector('.share-bar');
        var title = bar.dataset.title;
        var image = bar.dataset.image;
        var url = location.href;

        bar.querySelector('[data-wa]').href =
          'https://wa.me/?text=' + encodeURIComponent(title + ' — ' + url);

        var shareBtn = bar.querySelector('[data-share]');
        if (navigator.share) {
          shareBtn.onclick = function () { navigator.share({ title: title, url: url }); };
        } else {
          shareBtn.style.display = 'none';
        }

        bar.querySelector('[data-copy]').onclick = function (e) {
          navigator.clipboard.writeText(url).then(function () {
            e.target.textContent = '✅ Copiato!';
            setTimeout(function () { e.target.textContent = '🔗 Copia link'; }, 2000);
          });
        };

        // Instagram: prepara immagine + link e apre una guida rapida (post o storia)
        var igBtn = bar.querySelector('[data-ig]');
        if (!image) { igBtn.style.display = 'none'; }
        else {
          igBtn.onclick = function () {
            // copia il link per bio/sticker storia
            if (navigator.clipboard) navigator.clipboard.writeText(url).catch(function(){});
            var mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
            var overlay = document.createElement('div');
            overlay.className = 'ig-overlay';
            overlay.innerHTML =
              '<div class="ig-modal">' +
              '<button class="ig-close" aria-label="Chiudi">✕</button>' +
              '<h3>📸 Condividi su Instagram</h3>' +
              '<img class="ig-preview" src="' + image + '" alt="Anteprima post" />' +
              '<p class="ig-hint">🔗 Link copiato — usalo nella bio o nello sticker della storia.</p>' +
              '<div class="ig-actions">' +
              '<a class="ig-dl" href="' + image + '" download target="_blank" rel="noopener">⬇️ Salva immagine</a>' +
              (mobile ? '<button class="ig-nat">📲 Condividi immagine</button>' : '') +
              '</div>' +
              '<ol class="ig-steps">' +
              '<li>Salva l’immagine qui sopra.</li>' +
              '<li>Aprila su Instagram come <b>post</b> o <b>storia</b>.</li>' +
              '<li>Nella storia aggiungi lo sticker <b>Link</b> e incolla l’indirizzo (già copiato).</li>' +
              '</ol>' +
              '</div>';
            document.body.appendChild(overlay);
            var close = function () { overlay.remove(); };
            overlay.querySelector('.ig-close').onclick = close;
            overlay.onclick = function (e) { if (e.target === overlay) close(); };
            var nat = overlay.querySelector('.ig-nat');
            if (nat) nat.onclick = function () {
              // Su mobile prova a condividere direttamente il file immagine
              fetch(image).then(function (r) { return r.blob(); }).then(function (blob) {
                var file = new File([blob], 'italiannextgen.jpg', { type: 'image/jpeg' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                  navigator.share({ files: [file], title: title, text: title + ' — ' + url });
                } else {
                  navigator.share({ title: title, url: url });
                }
              }).catch(function () { navigator.share({ title: title, url: url }); });
            };
          };
        }
      })();
    </script>
  </article>
</Base>
